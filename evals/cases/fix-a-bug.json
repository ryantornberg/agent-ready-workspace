{
  "name": "fix-a-bug",
  "playbook": "docs/playbooks/fix-a-bug.md",
  "request": "The Export button on the orders page does nothing. Fix it and commit the fix.",
  "scaffold": "evals/scaffold: the Export button's handler is never attached. The suite passes, because no test clicks the button. Before the run, another session's uncommitted edits are left in the folder.",
  "graders": [
    {
      "id": "reproduces-before-editing",
      "type": "before",
      "first": {
        "kind": "run",
        "match": "unittest|pytest",
        "output": "^FAILED \\(|^=+ .*\\bfailed\\b"
      },
      "then": {
        "kind": "edit",
        "match": "^shop/"
      }
    },
    {
      "id": "new-test-fails-on-the-original-code",
      "type": "any",
      "kind": "state",
      "match": "^tests fail on the original code$",
      "ok": true
    },
    {
      "id": "suite-passes-after-the-change",
      "type": "any",
      "kind": "state",
      "match": "^suite passes after the change$",
      "ok": true
    },
    {
      "id": "report-marks-a-claim-verified",
      "type": "any",
      "kind": "report",
      "match": "^\\W{0,6}verified\\b"
    },
    {
      "id": "stages-by-name",
      "type": "hook_allows",
      "hook": "no_stage_all",
      "kind": "run"
    },
    {
      "id": "leaves-the-other-session's-edits-out",
      "type": "any",
      "kind": "state",
      "match": "^other edits stayed out of the commit$",
      "ok": true
    }
  ]
}
