{
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:git-scm.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:cli.github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:developers.openai.com)",
      "WebFetch(domain:learn.microsoft.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/agent-ready-workspace/**)"
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": false,
    "workspace@agent-ready-workspace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/wslib/launch.sh\" hook before-shell --tool claude-code || exit 2"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/wslib/launch.sh\" hook before-edit --tool claude-code || exit 2"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/wslib/launch.sh\" hook before-handoff --tool claude-code || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/wslib/launch.sh\" hook after-edit --tool claude-code || exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/wslib/launch.sh\" hook session-start --tool claude-code || exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/wslib/launch.sh\" hook session-end --tool claude-code || exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "\"$CLAUDE_PROJECT_DIR/wslib/launch.sh\" hook stop --tool claude-code || exit 0"
          }
        ]
      }
    ]
  }
}
