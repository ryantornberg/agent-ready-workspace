{
  "enabledPlugins": {"playwright@claude-plugins-official": false},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/wslib/launch.sh\" hook before-shell --tool claude-code || exit 2"}]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/wslib/launch.sh\" hook before-edit --tool claude-code || exit 2"}]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/wslib/launch.sh\" hook before-handoff --tool claude-code || exit 2"}]
      }
    ]
  }
}
