{
  "tiers": {
    "driver": {
      "model": "opus",
      "effort": "high"
    },
    "worker": {
      "model": "opus",
      "effort": "medium"
    },
    "mechanical": {
      "model": "haiku",
      "effort": "low"
    }
  },
  "parts": [
    {
      "use": "links",
      "skip": [
        "evals/scaffold"
      ]
    },
    {
      "use": "freshness",
      "max_age_days": 180,
      "require": [
        "docs"
      ],
      "skip": [
        "evals/scaffold"
      ]
    },
    {
      "use": "aliases",
      "index": "INDEX.md",
      "heading": "Search aliases",
      "code": "src",
      "exclude": [
        "src/orders-service-v1"
      ]
    },
    {
      "use": "eval_record",
      "playbooks": "docs/playbooks"
    },
    {
      "use": "no_stage_all"
    },
    {
      "use": "shelved",
      "paths": [
        "src/orders-service-v1"
      ]
    },
    {
      "use": "deny_list"
    }
  ]
}
