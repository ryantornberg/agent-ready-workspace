#!/bin/sh
# Check the commit message, the author and the committer against the parts that read them: the private deny list.
# Install once, with the other hooks: git config core.hooksPath .githooks
# git runs a hook at the top of the working copy, so the message file's path, relative or not, stays valid there.
# The launcher starts Python; with none that will do, or a missing launcher, the commit is refused.
exec sh wslib/launch.sh ws.py check --message "$1"
