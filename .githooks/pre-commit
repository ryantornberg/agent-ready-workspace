#!/bin/sh
# Check exactly what is being committed: the staged snapshot, not the folder around it.
# Another session's unsaved edits cannot make this pass or fail.
# Install once: git config core.hooksPath .githooks
# The launcher starts Python; with none that will do, or a missing launcher, the commit is refused.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec sh wslib/launch.sh ws.py check --staged
