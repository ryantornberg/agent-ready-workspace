#!/bin/sh
# Check the docs before each commit. A staged page that is past its review date fails.
# Install once: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
PY=$(command -v python3 || command -v python) || { echo "pre-commit: python not found" >&2; exit 1; }
# shellcheck disable=SC2046
exec "$PY" checks/check_docs.py --changed $(git diff --cached --name-only --diff-filter=ACMR -- '*.md')
