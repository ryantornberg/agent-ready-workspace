#!/bin/sh
# Drop the paths this commit holds from the edit ledger, and close the ledger when nothing is left.
# A post-commit hook cannot undo the commit, so a failure here, the launcher's included, is reported and nothing else.
cd "$(git rev-parse --show-toplevel)" || exit 0
sh wslib/launch.sh ws.py ledger --committed || echo "post-commit: the edit ledger was not updated; see: wslib/launch.sh ws.py ledger" >&2
exit 0
