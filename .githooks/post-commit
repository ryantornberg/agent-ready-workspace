#!/bin/sh
# Drop the paths this commit holds from the edit ledger, and close the ledger when nothing is left.
# A post-commit hook cannot undo the commit, so a failure here is reported and nothing else.
cd "$(git rev-parse --show-toplevel)" || exit 0
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys; sys.exit(sys.version_info < (3, 9))" 2>/dev/null; then
    "$candidate" ws.py ledger --committed || echo "post-commit: the edit ledger was not updated; see: python3 ws.py ledger" >&2
    exit 0
  fi
done
exit 0
