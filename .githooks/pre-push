#!/bin/sh
# Refuse a direct push to main whose new commits change machinery: scripts, hooks or CI.
# Machinery reaches main through a pull request. git gives the refs on standard input; they pass straight through.
# Install once, with the other hooks: git config core.hooksPath .githooks
# The launcher starts Python; with none that will do, or a missing launcher, the push is refused.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec sh wslib/launch.sh ws.py check --push "$1"
