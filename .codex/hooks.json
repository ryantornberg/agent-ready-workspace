{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [{"type": "command", "timeout": 30, "command": "\"$(git rev-parse --show-toplevel)/wslib/launch.sh\" hook before-shell --tool codex || exit 2"}]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [{"type": "command", "timeout": 30, "command": "\"$(git rev-parse --show-toplevel)/wslib/launch.sh\" hook before-edit --tool codex || exit 2"}]
      },
      {
        "matcher": "^spawn_agent$",
        "hooks": [{"type": "command", "timeout": 30, "command": "\"$(git rev-parse --show-toplevel)/wslib/launch.sh\" hook before-handoff --tool codex || exit 2"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [{"type": "command", "timeout": 30, "command": "\"$(git rev-parse --show-toplevel)/wslib/launch.sh\" hook after-edit --tool codex || exit 0"}]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{"type": "command", "timeout": 30, "command": "\"$(git rev-parse --show-toplevel)/wslib/launch.sh\" hook session-start --tool codex || exit 0"}]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{"type": "command", "timeout": 30, "command": "\"$(git rev-parse --show-toplevel)/wslib/launch.sh\" hook session-end --tool codex || exit 0"}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "timeout": 30, "command": "\"$(git rev-parse --show-toplevel)/wslib/launch.sh\" hook stop --tool codex || exit 0"}]
      }
    ]
  }
}
