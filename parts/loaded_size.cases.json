 {
  "name": "descriptions are counted, not bodies",
  "config": {
   "limits": [
    {
     "what": "wrapper descriptions",
     "max_bytes": 10,
     "glob": "plugin/skills/*/SKILL.md",
     "field": "description"
    }
   ]
  },
  "files": {
   "plugin/skills/a/SKILL.md": "---\nname: a\ndescription: 12345\n---\nA long body that does not load until the skill fires.\n",
   "plugin/skills/b/SKILL.md": "---\ndescription: \"123456\"\n---\n"
  },
  "expect": [
   "wrapper descriptions loads 11 bytes"
  ]
 },
