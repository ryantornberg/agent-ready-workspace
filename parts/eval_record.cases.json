[
  {
    "name": "a matching hash and a passing record pass",
    "files": {
      "evals/cases/fix.json": "{\"name\": \"fix\", \"playbook\": \"docs/fix.md\", \"guidance\": [\"docs/done.md\"]}",
      "docs/fix.md": "# Fix\n",
      "docs/done.md": "# Done\n",
      "evals/runs/fix/record.json": "{\"guidance_sha256\": \"9168e20fc44460a9650a2fe84f9ae55b32fc383c647539470118050dba33d6f6\", \"with_guidance\": {\"passed\": true}}"
    },
    "expect": []
  },
  {
    "name": "an edited playbook fails until its case is run again",
    "files": {
      "evals/cases/fix.json": "{\"name\": \"fix\", \"playbook\": \"docs/fix.md\", \"guidance\": [\"docs/done.md\"]}",
      "docs/fix.md": "# Fix, reworded\n",
      "docs/done.md": "# Done\n",
      "evals/runs/fix/record.json": "{\"guidance_sha256\": \"9168e20fc44460a9650a2fe84f9ae55b32fc383c647539470118050dba33d6f6\", \"with_guidance\": {\"passed\": true}}"
    },
    "expect": [
      "changed since the last recorded eval run; run case fix again"
    ]
  },
  {
    "name": "so does an edit to the other guidance the agent is given",
    "files": {
      "evals/cases/fix.json": "{\"name\": \"fix\", \"playbook\": \"docs/fix.md\", \"guidance\": [\"docs/done.md\"]}",
      "docs/fix.md": "# Fix\n",
      "docs/done.md": "# Done, reworded\n",
      "evals/runs/fix/record.json": "{\"guidance_sha256\": \"9168e20fc44460a9650a2fe84f9ae55b32fc383c647539470118050dba33d6f6\", \"with_guidance\": {\"passed\": true}}"
    },
    "expect": [
      "changed since the last recorded eval run"
    ]
  },
  {
    "name": "and an edit to the case's own graders",
    "files": {
      "evals/cases/fix.json": "{\"name\": \"fix\", \"playbook\": \"docs/fix.md\", \"guidance\": [\"docs/done.md\"], \"graders\": []}",
      "docs/fix.md": "# Fix\n",
      "docs/done.md": "# Done\n",
      "evals/runs/fix/record.json": "{\"guidance_sha256\": \"9168e20fc44460a9650a2fe84f9ae55b32fc383c647539470118050dba33d6f6\", \"with_guidance\": {\"passed\": true}}"
    },
    "expect": [
      "changed since the last recorded eval run"
    ]
  },
  {
    "name": "line endings alone do not count as an edit",
    "files": {
      "evals/cases/fix.json": "{\"name\": \"fix\", \"playbook\": \"docs/fix.md\", \"guidance\": [\"docs/done.md\"]}",
      "docs/fix.md": "# Fix\r\n",
      "docs/done.md": "# Done\n",
      "evals/runs/fix/record.json": "{\"guidance_sha256\": \"9168e20fc44460a9650a2fe84f9ae55b32fc383c647539470118050dba33d6f6\", \"with_guidance\": {\"passed\": true}}"
    },
    "expect": []
  },
  {
    "name": "a matching record that did not pass fails",
    "files": {
      "evals/cases/fix.json": "{\"name\": \"fix\", \"playbook\": \"docs/fix.md\", \"guidance\": [\"docs/done.md\"]}",
      "docs/fix.md": "# Fix\n",
      "docs/done.md": "# Done\n",
      "evals/runs/fix/record.json": "{\"guidance_sha256\": \"9168e20fc44460a9650a2fe84f9ae55b32fc383c647539470118050dba33d6f6\", \"with_guidance\": {\"passed\": false}}"
    },
    "expect": [
      "did not pass"
    ]
  },
  {
    "name": "passed must be true, not merely present",
    "files": {
      "evals/cases/fix.json": "{\"name\": \"fix\", \"playbook\": \"docs/fix.md\", \"guidance\": [\"docs/done.md\"]}",
      "docs/fix.md": "# Fix\n",
      "docs/done.md": "# Done\n",
      "evals/runs/fix/record.json": "{\"guidance_sha256\": \"9168e20fc44460a9650a2fe84f9ae55b32fc383c647539470118050dba33d6f6\", \"with_guidance\": {\"passed\": \"no\"}}"
    },
    "expect": [
      "did not pass"
    ]
  },
  {
    "name": "no run on record fails",
    "files": {
      "evals/cases/fix.json": "{\"name\": \"fix\", \"playbook\": \"docs/fix.md\", \"guidance\": [\"docs/done.md\"]}",
      "docs/fix.md": "# Fix\n",
      "docs/done.md": "# Done\n"
    },
    "expect": [
      "no eval run on record for case fix"
    ]
  },
  {
    "name": "a record that is not an object is reported, not a crash",
    "files": {
      "evals/cases/fix.json": "{\"name\": \"fix\", \"playbook\": \"docs/fix.md\", \"guidance\": [\"docs/done.md\"]}",
      "docs/fix.md": "# Fix\n",
      "docs/done.md": "# Done\n",
      "evals/runs/fix/record.json": "[]"
    },
    "expect": [
      "not a readable eval record"
    ]
  },
  {
    "name": "a case that covers a missing file fails",
    "files": {
      "evals/cases/fix.json": "{\"name\": \"fix\", \"playbook\": \"docs/fix.md\", \"guidance\": [\"docs/done.md\"]}",
      "docs/fix.md": "# Fix\n"
    },
    "expect": [
      "a file the case covers is missing: docs/done.md"
    ]
  },
  {
    "name": "a broken case file is reported, not a crash",
    "files": {
      "evals/cases/fix.json": "{not json"
    },
    "expect": [
      "not a readable eval case"
    ]
  },
  {
    "name": "a playbook with no case fails where every playbook must have one",
    "files": {
      "evals/cases/fix.json": "{\"name\": \"fix\", \"playbook\": \"docs/fix.md\", \"guidance\": [\"docs/done.md\"]}",
      "docs/fix.md": "# Fix\n",
      "docs/done.md": "# Done\n",
      "evals/runs/fix/record.json": "{\"guidance_sha256\": \"9168e20fc44460a9650a2fe84f9ae55b32fc383c647539470118050dba33d6f6\", \"with_guidance\": {\"passed\": true}}",
      "docs/new.md": "# New\n"
    },
    "config": {
      "playbooks": "docs"
    },
    "expect": [
      "no eval case tests this playbook"
    ]
  }
]
