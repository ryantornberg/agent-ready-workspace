[
  {"name": "add -A", "event": {"command": "git add -A"}, "remind": true},
  {"name": "add -A with extra spaces", "event": {"command": "git  add   -A"}, "remind": true},
  {"name": "add --all", "event": {"command": "git add --all"}, "remind": true},
  {"name": "add dot", "event": {"command": "git add ."}, "remind": true},
  {"name": "add -u", "event": {"command": "git add -u"}, "remind": true},
  {"name": "add star", "event": {"command": "git add *"}, "remind": true},
  {"name": "add from the repository root", "event": {"command": "git add :/"}, "remind": true},
  {"name": "combined short flags", "event": {"command": "git add -vA"}, "remind": true},
  {"name": "git stage is git add", "event": {"command": "git stage ."}, "remind": true},
  {"name": "commit -am", "event": {"command": "git commit -am 'fix export'"}, "remind": true},
  {"name": "commit -a -m", "event": {"command": "git commit -a -m fix"}, "remind": true},
  {"name": "commit --all", "event": {"command": "git commit --all -m fix"}, "remind": true},
  {"name": "after another command", "event": {"command": "npm test && git add -A && git commit -m fix"}, "remind": true},
  {"name": "after a semicolon with no space", "event": {"command": "cd app; git add ."}, "remind": true},
  {"name": "with a global option", "event": {"command": "git -C app add -A"}, "remind": true},
  {"name": "through a path to git", "event": {"command": "/usr/bin/git add -A"}, "remind": true},
  {"name": "behind an environment variable and a wrapper", "event": {"command": "GIT_PAGER=cat command git add -A"}, "remind": true},
  {"name": "inside parentheses", "event": {"command": "(cd app && git add .)"}, "remind": true},
  {"name": "directly inside parentheses", "event": {"command": "(git add -A)"}, "remind": true},
  {"name": "on a second line", "event": {"command": "echo x\ngit add -A"}, "remind": true},
  {"name": "inside an if", "event": {"command": "if true; then git add -A; fi"}, "remind": true},
  {"name": "inside sh -c", "event": {"command": "bash -c 'git add -A'"}, "remind": true},
  {"name": "a glob of everything", "event": {"command": "git add ./*"}, "remind": true},
  {"name": "an abbreviated long option", "event": {"command": "git add --al"}, "remind": true},
  {"name": "behind timeout", "event": {"command": "timeout 5 git add -A"}, "remind": true},
  {"name": "commit of the whole folder", "event": {"command": "git commit . -m x"}, "remind": true},
  {"name": "after a line continuation", "event": {"command": "git add \\\n  -A"}, "remind": true},
  {"name": "a login shell with -lc", "event": {"command": "bash -lc \"git add -A\""}, "remind": true},
  {"name": "timeout with a unit", "event": {"command": "timeout 5s git add -A"}, "remind": true},
  {"name": "sudo with its own option", "event": {"command": "sudo -u me git add -A"}, "remind": true},
  {"name": "eval", "event": {"command": "eval 'git add -A'"}, "remind": true},
  {"name": "add by name", "event": {"command": "git add src/orders/export.js tests/orders/export.test.js"}, "remind": false},
  {"name": "add by name with a leading dot-slash", "event": {"command": "git add ./src/x.js"}, "remind": false},
  {"name": "add a dot-folder by name", "event": {"command": "git add .github/workflows/ci.yml"}, "remind": false},
  {"name": "add a quoted name with spaces", "event": {"command": "git add 'docs/my page.md'"}, "remind": false},
  {"name": "commit with a message", "event": {"command": "git commit -m 'add a test for all cases'"}, "remind": false},
  {"name": "a message that mentions the flag", "event": {"command": "git commit -m \"never use git add -A\""}, "remind": false},
  {"name": "commit --amend is not -a", "event": {"command": "git commit --amend --no-edit"}, "remind": false},
  {"name": "other git commands", "event": {"command": "git status && git diff --stat && git log -a"}, "remind": false},
  {"name": "not git at all", "event": {"command": "echo git add -A is refused here"}, "remind": false},
  {"name": "an event with no command", "event": {"path": "docs/a.md"}, "remind": false},
  {"name": "xargs passes names", "event": {"command": "git diff --name-only | xargs git add"}, "remind": false},
  {"name": "sh -c that stages by name", "event": {"command": "sh -c 'git add a.md && git commit -m x'"}, "remind": false},
  {"name": "a heredoc commit message that mentions the command", "event": {"command": "git add a.py && git commit -F - <<'EOF'\nRefuse more spellings\n\n- git add ./* is now refused\n- so is git add -A\nEOF"}, "remind": false},
  {"name": "a multi-line -m message that mentions the command", "event": {"command": "git commit -m \"Fix staging\n\ngit add -A is refused now\""}, "remind": false},
  {"name": "writing notes that mention the command", "event": {"command": "cat > NOTES.md <<'EOF'\nnever run git add -A\nEOF"}, "remind": false},
  {"name": "a real command after the heredoc still counts", "event": {"command": "cat > NOTES.md <<EOF\nnotes\nEOF\ngit add -A"}, "remind": true},
  {"name": "add -p, add -- file, and -c before add", "event": {"command": "git add -p src/a.py; git add -- b.py; git -c core.autocrlf=false add c.py"}, "remind": false},
  {"name": "a message attached to -m holds no -a", "event": {"command": "git commit -m\"add export handler\""}, "remind": false},
  {"name": "a message of a single dot is not a pathspec", "event": {"command": "git commit -m ."}, "remind": false},
  {"name": "add -u with a path names that path", "event": {"command": "git add -u docs/parts.md"}, "remind": false},
  {"name": "add -A with a path after --", "event": {"command": "git add -A -- docs/a.md"}, "remind": false},
  {"name": "add -u with the whole folder", "event": {"command": "git add -u ."}, "remind": true},
  {"name": "a value taken by a long option is not a pathspec", "event": {"command": "git commit --author 'A <a@example.invalid>' -m x"}, "remind": false}
]
