[
  {
    "name": "both tools' configs pinned and isolated, and the plugin off, pass",
    "files": {
      ".claude/settings.json": "{\"hooks\": {}, \"enabledPlugins\": {\"playwright@claude-plugins-official\": false}}",
      ".mcp.json": "{\"mcpServers\": {\"playwright\": {\"command\": \"npx\", \"args\": [\"@playwright/mcp@0.0.84\", \"--isolated\"]}}}",
      ".codex/config.toml": "[mcp_servers.playwright]\ncommand = \"npx\"\nargs = [\"@playwright/mcp@0.0.84\", \"--isolated\"]\n"
    },
    "config": {
      "settings": ".claude/settings.json",
      "plugin": "playwright@claude-plugins-official",
      "package": "@playwright/mcp",
      "configs": {
        "claude-code": ".mcp.json",
        "codex": ".codex/config.toml"
      }
    },
    "expect": []
  },
  {
    "name": "the plugin left out of the project settings fails, since user settings may turn it on",
    "files": {
      ".claude/settings.json": "{\"hooks\": {}}",
      ".mcp.json": "{\"mcpServers\": {\"playwright\": {\"command\": \"npx\", \"args\": [\"@playwright/mcp@0.0.84\", \"--isolated\"]}}}",
      ".codex/config.toml": "[mcp_servers.playwright]\ncommand = \"npx\"\nargs = [\"@playwright/mcp@0.0.84\", \"--isolated\"]\n"
    },
    "config": {
      "settings": ".claude/settings.json",
      "plugin": "playwright@claude-plugins-official",
      "package": "@playwright/mcp",
      "configs": {
        "claude-code": ".mcp.json",
        "codex": ".codex/config.toml"
      }
    },
    "expect": [
      "must set enabledPlugins"
    ]
  },
  {
